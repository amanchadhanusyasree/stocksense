# Copy this file to .env. Never commit .env or share these secret values.
BASE_URL=
NODE_ENV=development

# OpenAI API key for the AI Help Center (keep this server-side; do not expose in frontend code)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend: create an API key and verify the sender domain used by MAIL_FROM
RESEND_API_KEY=
MAIL_FROM=StockSense <no-reply@example.com>

# Twilio: account credentials and a Twilio phone number enabled for SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional Gemini API key for AI Help Center
GEMINI_API_KEY=AQ.Ab8RN6LBlTyHIGOImpR7uAEW7WOe2uL7DnByLOwVGbtboYG-Vw
GEMINI_MODEL=gemini-3.8-flash
